<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
    <Domain id="any">
        <General>
            <!-- Increase the network interface selection priority for Ethernet over Wi-Fi -->
            <!-- <NetworkInterface name="eth0" priority="2"/>
            <NetworkInterface name="wlan0" priority="0" autodetect="true"/>
             -->
            <!-- Multicast SPDP so other LAN machines discover our topics -->
            <AllowMulticast>true</AllowMulticast>
            <!-- Allow fragmentation for large messages -->
            <FragmentSize>4096B</FragmentSize>
        </General>
        <Discovery>
            <!-- Multicast handles discovery on a normal LAN.
                 If the switch/router BLOCKS multicast, list each remote
                 device IP here for unicast discovery instead: -->
            <!-- <Peers>
                <Peer address="192.168.1.50"/>
            </Peers> -->
        </Discovery>
        <Internal>
            <!-- Grow send/recv buffers for large messages. min="default" = start
                 at OS default so node creation never hard-fails; max="120MB" =
                 best-effort grow, capped by host net.core.rmem_max/wmem_max.
                 To actually reach 120MB, raise those on the HOST (see below). -->
            <SocketReceiveBufferSize min="default" max="120MB"/>
            <SocketSendBufferSize min="default" max="120MB"/>

            <!-- Watermarks to manage memory usage and prevent runaway buffering -->
            <!-- High watermark: when to start blocking the writer -->
            <Watermarks>
                <WhcHigh>100MB</WhcHigh>
            </Watermarks>
        </Internal>
        <Tracing>
            <!-- Uncomment for verbose logging to debug DDS issues -->
            <!-- <Verbosity>finest</Verbosity> -->
            <!-- <OutputFile>cyclonedds.log</OutputFile> -->
        </Tracing>
    </Domain>
</CycloneDDS>
